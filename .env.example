# WordPress CMS REST API Base
NEXT_PUBLIC_WP_API_URL=http://localhost:8888/wp-json
NEXT_PUBLIC_APNASTAY_API_URL=http://localhost:8888/wp-json/apnastay/v1
NEXT_PUBLIC_WP_ADMIN_URL=http://localhost:8888/wp-admin/

# Google Maps API Key (Optional)
# If provided, ApnaStay automatically upgrades to Google Maps & Google Places Autocomplete.
# If omitted or empty, ApnaStay uses 100% free OpenStreetMap + Leaflet with zero credit card needed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
