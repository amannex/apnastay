# ==============================================================================
# APNASTAY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Canonical Site URL (defaults to http://localhost:3000 in dev, https://apnastay.in in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress CMS REST API Base (defaults to http://localhost:8888/wp-json in dev, https://cms.apnastay.in/wp-json in prod)
NEXT_PUBLIC_WP_API_URL=http://localhost:8888/wp-json

# Custom ApnaStay REST API Base
NEXT_PUBLIC_APNASTAY_API_URL=http://localhost:8888/wp-json/apnastay/v1

# WordPress Admin Dashboard URL (defaults to http://localhost:8888/wp-admin/ in dev, https://cms.apnastay.in/wp-admin/ in prod)
NEXT_PUBLIC_WP_ADMIN_URL=http://localhost:8888/wp-admin/

# Webhook Secret Key for on-demand ISR Cache Purging
WP_WEBHOOK_SECRET=apnastay-wp-cms-secret-key-2026

# Google Maps API Key (Optional)
# If provided, ApnaStay automatically upgrades to Google Maps & Google Places Autocomplete.
# If omitted or empty, ApnaStay uses 100% free OpenStreetMap + Leaflet with zero credit card needed.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
